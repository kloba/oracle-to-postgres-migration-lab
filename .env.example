# ===========================================================================
# Contoso Store  -  Oracle to Azure Database for PostgreSQL migration lab
# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
#
#   cp .env.example .env && chmod 600 .env
#   set -a; . ./.env; set +a
#
# Every script in scripts/ sources .env. No password is ever hardcoded in a
# .sql, .sh, .py or .bicep file in this repo. For anything beyond a throwaway
# local lab, prefer the az keyvault indirection at the bottom of this file and
# leave the *_PASSWORD variables empty.
#
# THIS IS A PUBLIC REPO: no real tenant ids, subscription ids, resource names,
# endpoints or passwords may be pasted back into .env.example.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. Oracle source database (the thing being migrated)
# ---------------------------------------------------------------------------
# The lab runs Oracle Database Free 23ai in a container.
#
# ORACLE_IMAGE below is what the AZURE VM path pulls (scripts/install-oracle.sh
# and scripts/cloud-init/oracle-vm.yaml, via deploy.sh). Its default is Oracle's
# official image.
#
# The LOCAL Docker path does NOT read ORACLE_IMAGE -- you start the container by
# hand (docs/02-seed-oracle.md). That path, and the oracle-smoke CI workflow,
# were verified against gvenzl/oracle-free:23-slim, which needs no registry
# login and starts far faster, so it is the local default. The official image
# works locally too, but it is a ~9 GB pull and needs a one-time
# `docker login container-registry.oracle.com` after you accept the licence.
#
# docs/design.md: Microsoft documents 12.1 / 12.2 / 18c / 19c / 21c as the
# supported source versions, and 23ai is NOT on that list even though
# Microsoft's own lab deploys it. Set ORACLE_IMAGE to a 19c/21c image if you
# want to stay strictly inside the supported matrix.
ORACLE_IMAGE=container-registry.oracle.com/database/free:latest
ORACLE_CONTAINER_NAME=o2p-oracle
ORACLE_HOST=localhost
ORACLE_PORT=1521
# PDB service name. Fixed by the contract - do not rename.
ORACLE_SERVICE=FREEPDB1
# CDB root service. Used by scripts/install-oracle.sh (and the cloud-init that
# calls it) for container-level operations, and handed to
# src/oracle/00-user-tablespace.sql as &cdb_service by scripts/seed-oracle.sh.
ORACLE_CDB_SERVICE=FREE

# Admin account used purely for setup (create user, grants, directories).
ORACLE_SYSTEM_USER=SYSTEM
# CHANGE THIS. 12+ chars, at least one digit, no leading digit, no '@' or '/'
# (sqlplus easy-connect strings choke on both).
ORACLE_SYSTEM_PASSWORD=replace-me-oracle-system-pw

# The schema being migrated. Fixed by the contract - do not rename.
CONTOSO_SCHEMA=CONTOSO
# CHANGE THIS. Owner of all ~1,855 objects.
CONTOSO_PASSWORD=replace-me-contoso-pw

# A second, low-privilege Oracle account created for the conversion tool.
# It gets CONNECT + SELECT_CATALOG_ROLE (or SELECT ANY DICTIONARY) + SELECT on
# SYS.ARGUMENT$. It reads metadata only and never touches application rows.
# Created by scripts/install-oracle.sh, not by any .sql file - so it survives
# a DROP USER CONTOSO CASCADE and is recreated by re-running that script.
ORACLE_MIGRATION_USER=O2P_READER
# CHANGE THIS.
ORACLE_MIGRATION_PASSWORD=replace-me-reader-pw

# Oracle 'sessions' initialisation parameter must be > 10 for the extension's
# parallel metadata reads. scripts/install-oracle.sh asserts this and raises it
# if the image came up lower.
ORACLE_MIN_SESSIONS=50

# Name of the Oracle DIRECTORY object that pkg_etl_export writes to via UTL_FILE
# (hard case H-13). scripts/install-oracle.sh and scripts/cloud-init/oracle-vm.yaml
# create it (CREATE OR REPLACE) and choose the host path themselves, under the
# VM's Oracle data mount -- there is no host-dir variable to set. It lives at
# database level, so DROP USER CONTOSO CASCADE does not take it with it.
ORACLE_UTL_FILE_DIR_NAME=CONTOSO_EXPORT_DIR


# ---------------------------------------------------------------------------
# 2. Target: Azure Database for PostgreSQL flexible server
# ---------------------------------------------------------------------------
# PostgreSQL 15 or later. Azure HorizonDB is supported as a TARGET from
# extension v1.27.x, but is NOT supported as the scratch database (section 3).
PGHOST=o2p-pg-target.postgres.database.azure.com
PGPORT=5432
# Fixed by the contract - do not rename.
PGDATABASE=contoso_store
PGUSER=o2padmin
# Leave empty and use AZ_KEYVAULT_NAME below, or set for a local-only run.
PGPASSWORD=
PGSSLMODE=require
# Fixed by the contract - do not rename.
PG_TARGET_SCHEMA=contoso

# Extensions that must be allowlisted in the azure.extensions server parameter
# on BOTH the target and the scratch server before the first conversion run.
# dblink is only required if the source uses PRAGMA AUTONOMOUS_TRANSACTION -
# CONTOSO does, in pkg_audit / pkg_error / pkg_finance_gl - and it is needed on
# the TARGET, not just on scratch.
PG_REQUIRED_EXTENSIONS=orafce,uuid-ossp,pgcrypto,pg_trgm,postgis,postgis_topology,postgis_tiger_geocoder,pg_partman,pg_stat_statements,plpgsql_check,dblink

# These three additionally need shared_preload_libraries + a server RESTART.
PG_PRELOAD_LIBRARIES=pg_partman_bgw,pg_stat_statements,plpgsql_check

# GOTCHA: plpgsql_check is FAIL-OPEN. If it is not allowlisted the conversion
# tool silently skips its deeper validation - no error, no warning in the
# report. scripts/status.sh checks the azure.extensions allowlist after the
# deployment and exits non-zero when plpgsql_check is missing. Run it before
# your first conversion run; a report produced without it cannot be retro-fixed.

# GOTCHA: pg_catalog is always searched first, so to_char / to_date / substr
# resolve to the PostgreSQL builtins, not to orafce's Oracle-compatible ones.
# Set this as the DATABASE-level search_path and call oracle.to_char(...)
# explicitly wherever Oracle semantics are required.
PG_SEARCH_PATH=contoso,public,oracle,topology,tiger,dbms_output,dbms_lob,dbms_random,plvstr,plvsubst,utl_file


# ---------------------------------------------------------------------------
# 3. Scratch database used by the conversion tool
# ---------------------------------------------------------------------------
# MUST be Azure Database for PostgreSQL flexible server, PostgreSQL 15+.
# Azure HorizonDB is explicitly NOT supported here. The tool creates and drops
# schemas prefixed _mig_scratch_ , so give it its own DATABASE.
#
# A separate database, NOT a separate server. SCRATCH_PGHOST is the same host
# as PGHOST above - one server, two databases, so the server-level
# azure.extensions allowlist and shared_preload_libraries cover both at once.
# See docs/01-deploy-infrastructure.md, "Two databases on one server".
SCRATCH_PGHOST=o2p-pg-target.postgres.database.azure.com
SCRATCH_PGPORT=5432
SCRATCH_PGDATABASE=migration_scratch
SCRATCH_PGUSER=o2padmin
SCRATCH_PGPASSWORD=
SCRATCH_PGSSLMODE=require


# ---------------------------------------------------------------------------
# 4. Azure resources
# ---------------------------------------------------------------------------
# All resource names in the lab are derived from AZ_PREFIX.
AZ_PREFIX=o2p
AZ_LOCATION=swedencentral
AZ_RESOURCE_GROUP=o2p-migration-lab-rg
# Placeholder only. Never commit a real subscription id. The tenant is taken
# from `az account show`, so there is no tenant variable to set here.
AZ_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Key Vault name must be globally unique; append your own suffix.
AZ_KEYVAULT_NAME=o2p-kv-changeme

# --- SKUs and sizes that scripts/deploy.sh passes to the Bicep template -----
# Change these when a region tells you SkuNotAvailable. "Quota is not
# availability": a family can show free cores in a region where the specific
# SKU is not offered to your subscription at all. preflight.sh probes both.
#
# The Oracle VM and the jumpbox both default to Standard_D4s_v5, i.e. the same
# standardDSv5Family pool - two 4-vCPU VMs need 8 vCPU in ONE family.
ORACLE_VM_SIZE=Standard_D4s_v5

# PostgreSQL flexible server compute. Empty means "use the template default"
# (Standard_D4ds_v5 / GeneralPurpose). Set both together:
#   az postgres flexible-server list-skus --location <region> -o table
PG_SKU_NAME=
PG_SKU_TIER=

# Azure Bastion SKU. MUST be Standard. Basic rejects native tunneling
# (enableTunneling), and `az network bastion tunnel` is how scripts/connect.sh
# and scripts/seed-oracle.sh --azure reach the Oracle VM and the VNet-private
# PostgreSQL server. infra/modules/bastion.bicep defaults to Basic; deploy.sh
# overrides it with this value. Standard costs more - see README "What it
# costs" - and Bastion cannot be stopped, only deleted.
AZ_BASTION_SKU=Standard

# --- SSH keypair for the Oracle VM ------------------------------------------
# Leave EMPTY for the normal path. scripts/deploy.sh generates an ed25519
# keypair at generated/ssh/${AZ_PREFIX}-lab_ed25519 and passes the public half
# to the template as oracleSshPublicKey; connect.sh and seed-oracle.sh read the
# private half back from that same location.
#
# Set this only if your private key lives somewhere else - it is the path
# connect.sh, deploy.sh and seed-oracle.sh fall back to. Note the VM only ever
# trusts the public key passed at CREATE time, so pointing this at a different
# key after deploying will not grant access; replace both halves of the
# keypair BEFORE running deploy.sh. There is deliberately no variable for the
# public key. See docs/troubleshooting.md "Permission denied (publickey)".
SSH_KEY_PATH=


# ---------------------------------------------------------------------------
# 5. Microsoft Foundry (formerly Azure AI Foundry) - the LLM behind conversion
# ---------------------------------------------------------------------------
FOUNDRY_RESOURCE_NAME=o2p-foundry
# Foundry accounts answer on TWO hostname families and either may be what your
# deployment returns: <name>.services.ai.azure.com and <name>.openai.azure.com.
# Learn's schema-conversion page gives the first, its VS Code extension page
# gives the second. Use whatever `jq -r .foundryEndpoint generated/outputs.json`
# actually prints, and allowlist that host for egress.
FOUNDRY_ENDPOINT=https://o2p-foundry.services.ai.azure.com/
FOUNDRY_DEPLOYMENT_NAME=o2p-schema-conversion

# MODEL CHOICE - deliberately a parameter, see docs/design.md section 9.
# learn.microsoft.com states the deployment must be gpt-5.2; Microsoft's own
# mslearn-postgresql lab ARM template defaults to gpt-5-mini. gpt-5.2 is VERIFIED
# DEPLOYABLE in swedencentral as of 2026-09-02 (version 2025-12-11) - which one to
# USE is still your call, and availability varies by region so preflight.sh
# checks it. Default here follows Learn; override to gpt-5-mini to match the sample.
FOUNDRY_MODEL_NAME=gpt-5.2
FOUNDRY_MODEL_VERSION=
# Recommended quota. Below this the tool throttles hard on a ~1,855-object schema.
FOUNDRY_TPM_QUOTA=500000

# RBAC CONFLICT - grant whichever your portal offers, and check both.
# Current Microsoft Foundry docs say the role is "Foundry User".
# DP-300 lab 18 says "Cognitive Services OpenAI User". Unresolved upstream.
FOUNDRY_RBAC_ROLE='Foundry User'
FOUNDRY_RBAC_ROLE_FALLBACK='Cognitive Services OpenAI User'


# ---------------------------------------------------------------------------
# 6. Client tooling
# ---------------------------------------------------------------------------
# The ONLY supported Oracle -> Azure PostgreSQL conversion path. There is no
# separate "Oracle to PostgreSQL" extension and no "migration copilot".
# REFERENCE ONLY: no script reads these three. They record the extension id and
# the versions the lab was written against so you can check your own client --
# VSCODE_MIN_VERSION is the VS Code floor, EXTENSION_MIN_VERSION the
# ms-ossdata.vscode-pgsql floor.
VSCODE_EXTENSION_ID=ms-ossdata.vscode-pgsql
VSCODE_MIN_VERSION=1.95.2
# Schema conversion is GA from v1.23.0 (2026-05-26). Application/code
# conversion (.sql .ctl .sh .load .java) is still PUBLIC PREVIEW.
EXTENSION_MIN_VERSION=1.23.0

# GitHub Copilot agent mode resolves the flagged review tasks. Requires a
# Copilot Pro+, Business or Enterprise seat - Free and plain Pro are NOT
# enough. Set it to the plan you actually hold; scripts/preflight.sh warns when
# it is a tier agent mode does not cover. Nothing can verify the seat itself
# from outside VS Code, so this is a reminder, not a gate.
COPILOT_PLAN=Business

# Client platform. Windows x64, Linux x64, or macOS 13+. ARM64 is NOT
# supported on Windows or Linux, and the overview page's thick-client section
# claims "Windows and Linux only" - so Apple Silicon is risky. Leave this at
# 'jumpbox' to have scripts/deploy.sh build the Windows x64 VM as part of the
# main template; set it to anything else and preflight.sh stops reserving
# jumpbox vCPU quota.
CLIENT_PLATFORM=jumpbox
JUMPBOX_VM_SIZE=Standard_D4s_v5
JUMPBOX_ADMIN_USER=o2padmin
JUMPBOX_ADMIN_PASSWORD=

# Outbound egress the client needs. Easy to miss the last one.
#   <FOUNDRY_ENDPOINT>
#   https://marketplace.visualstudio.com/
#   https://api.githubcopilot.com/ (and github.com auth)
#   https://github.com/microsoft/pgsql-tools/


# ---------------------------------------------------------------------------
# 7. Deterministic generators (tools/generate-objects.py, generate-data.py)
# ---------------------------------------------------------------------------
# Fixed seed keeps generated DDL and generated data byte-identical across runs
# and machines. Both generators read GEN_SEED and GEN_OUTPUT_DIR.
GEN_SEED=20260902
# REFERENCE ONLY - nothing reads this. The object generator owns the number:
# GEN_OBJECT_TARGET in tools/generate-objects.py is authoritative, and the
# generator asserts its own output against it. scripts/seed-oracle.sh
# deliberately does NOT pass it, because a target in two places drifts: this
# line said 760 while the generator moved to 792, seed-oracle.sh forwarded it
# as "--count 760", the generator turned that into a 760/792 = 0.9596
# multiplier, and every family shrank ~4%. The seed still said "verified"
# (99-verify-objects.sql only guards the 1000 floor) but the corpus was 763
# objects, four per-type minimums were short, and tests/verify-schema.sql went
# red. Worse, the budget assertion disarms itself for any multiplier but 1.0,
# so the short run reported nothing. Change the generator, not this line.
# 792 is what tests/verify-schema.sql asserts as k_generated_min, and what
# takes the seeded schema to its full object count.
# Set GEN_OBJECT_COUNT (a different variable) only to force a non-contract run.
GEN_OBJECT_TARGET=792
# Total the CONTOSO schema must reach. Hard floor from the contract is 1000,
# asserted by src/oracle/99-verify-objects.sql at the end of every seed.
OBJECT_COUNT_FLOOR=1000
# Output ROOT. generate-objects.py writes <root>/oracle/*.sql and
# generate-data.py writes <root>/oracle/data/*.sql - both append the subpath
# themselves, so point this at the root, not at generated/oracle.
GEN_OUTPUT_DIR=./generated


# ---------------------------------------------------------------------------
# 8. Data movement (the tool does NOT copy rows - see docs/design.md sec. 10)
# ---------------------------------------------------------------------------
# The VS Code extension converts SCHEMA AND CODE ONLY. Table rows need a
# separate step. Choose: ora2pg | pgloader | none. See docs/04-migrate-data.md.
DATA_MOVE_TOOL=ora2pg
ORA2PG_CONF=./tools/ora2pg.conf
# Row volume for tools/generate-data.py and for the seed SQL. The generator's
# own --scale takes small | medium | large; scripts/seed-oracle.sh --scale
# takes a numeric multiplier, maps it to the nearest of those three, and also
# hands these two values to the seed SQL as &order_rows and &customer_rows.
SEED_ORDER_ROWS=250000
SEED_CUSTOMER_ROWS=50000


# ---------------------------------------------------------------------------
# 9. Local paths and behaviour
# ---------------------------------------------------------------------------
LOG_DIR=./out/logs
# Set to 1 to make scripts echo every sqlplus/psql command before running it.
VERBOSE=0


# ---------------------------------------------------------------------------
# 10. Preferred: pull secrets from Key Vault instead of setting them above
# ---------------------------------------------------------------------------
# Leave the *_PASSWORD variables empty and set USE_KEYVAULT=1. Scripts then do:
#   az keyvault secret show --vault-name "$AZ_KEYVAULT_NAME" \
#      --name "$KV_SECRET_CONTOSO_PASSWORD" --query value -o tsv
USE_KEYVAULT=0
KV_SECRET_ORACLE_SYSTEM_PASSWORD=oracle-system-password
KV_SECRET_CONTOSO_PASSWORD=contoso-schema-password
KV_SECRET_ORACLE_MIGRATION_PASSWORD=oracle-reader-password
KV_SECRET_PG_PASSWORD=pg-target-password
KV_SECRET_SCRATCH_PG_PASSWORD=pg-scratch-password
KV_SECRET_JUMPBOX_ADMIN_PASSWORD=jumpbox-admin-password
